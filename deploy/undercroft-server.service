# Undercroft remote MCP server — systemd unit template.
#
# Install:
#   sudo useradd --system --home /var/lib/undercroft --shell /usr/sbin/nologin undercroft
#   sudo install -d -o undercroft -g undercroft -m 750 /var/lib/undercroft /etc/undercroft
#   sudo cp deploy/server.env.example /etc/undercroft/server.env   # edit, then chmod 600
#   sudo cp target/release/undercroft /usr/local/bin/
#   sudo cp deploy/undercroft-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now undercroft-server
#
# Binds 0.0.0.0:8765 and requires UNDERCROFT_MCP_HTTP_TOKEN (set in the
# EnvironmentFile). Front it with a TLS-terminating reverse proxy.
#
# Every start runs `undercroft init` first (ExecStartPre, ROADMAP O200), as
# the unit's user, with its data directory and its environment file, the
# passphrase among them. The first start sets up the master key and creates a
# SEALED `default` vault; later starts find that vault, and `init` exits 0
# without writing. A failed init stops the start, and its own error is in
# `journalctl -u undercroft-server`. Without it, a fresh install exited
# `vault "default" not found` and restarted every three seconds.
# For another level, create the vault before the first start;
# docs/remote-server.md has the command. If you change ExecStart to serve a
# vault other than `default` (`--vault`), remove ExecStartPre: it would create
# an empty `default` beside it.

[Unit]
Description=Undercroft remote MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=undercroft
Group=undercroft
EnvironmentFile=/etc/undercroft/server.env
Environment=UNDERCROFT_HOME=/var/lib/undercroft
ExecStartPre=/usr/local/bin/undercroft init
ExecStart=/usr/local/bin/undercroft serve-http --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/undercroft
PrivateTmp=true

[Install]
WantedBy=multi-user.target
