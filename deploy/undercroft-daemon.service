# Undercroft auto-save daemon — sweeps agent transcripts into a vault.
#
#   mkdir -p ~/.config/systemd/user && cp deploy/undercroft-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now undercroft-daemon
#
# Runs as a user service so it can read ~/.claude/projects.

[Unit]
Description=Undercroft transcript auto-save daemon

[Service]
Type=simple
ExecStart=%h/.cargo/bin/undercroft daemon run --watch %h/.claude/projects --interval 300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
