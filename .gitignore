/HANDOVER.md
HANDOVER*.md
.handover/

# Local design prototype for the Palace Monitor (superseded by the real
# served UI at crates/undercroft-cli/src/monitor.html). Kept locally only.
/mockups/
deploy/observability/docker-compose.binary.yml

# local benchmark runs (published logs are curated in benchmarks/logs/)
benchmarks/vs.env
benchmarks/logs/local/

# Benchmark-run working sets and research artifacts (local only — never
# committed). These hold a third-party benchmark's corpus content and its
# rendered prompts VERBATIM, and that clone ships no LICENSE, so it is
# all-rights-reserved by default: it must never enter this repo OR ITS
# HISTORY. Gitignoring is what makes keeping the full run data safe —
# the alternative is discarding evidence, which is worse. Aggregate
# figures carrying no corpus content are published the normal way, in
# benchmarks/logs/ and benchmarks/RESULTS.md, per that directory's own
# standing rule ("never benchmark-corpus content").
docs/research/

# Promiscuity corpora, fetched not committed (hermitdave/FrequencyWords, MIT):
#   curl -sSL https://raw.githubusercontent.com/hermitdave/FrequencyWords/master/content/2018/ar/ar_50k.txt -o crates/undercroft-store/testdata/ar_50k.txt
crates/undercroft-store/testdata/
.battery/

# Bytecode of the one tracked Python file, `tests/no-trace/verify.py`. The
# preflight EXECUTES it, so this appears only when something IMPORTS it — an
# ad-hoc probe did, while closing O26. Ignored because a committed `.pyc`
# sitting beside a GATE is a second, stale copy of the thing that decides.
__pycache__/
